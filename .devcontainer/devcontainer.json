{
  "name": "JJN PDF QA Web",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -r requirements-web.txt",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "PDF QA Web",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "nohup python -m pdf_qa_web --host 0.0.0.0 --port 8765 --no-browser > /tmp/web.log 2>&1 &"
}
